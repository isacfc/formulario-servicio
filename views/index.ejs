<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/styles.css" rel="stylesheet">
  <title>Formulario - Poder Judicial</title>
</head>

<body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">

  <!-- Encabezado -->
  <header class="w-full bg-verdegris shadow-md p-3 flex justify-center items-center">
    <img src="/images/pj-logo.png" alt="Logo" class="mr-24 w-24 h-auto">
    <label class="text-2xl md:text-3xl font-bold text-white">Poder Judicial del Estado de Hidalgo</label>
  </header>

  <!-- Títulos -->
  <div class="mt-16 text-center">
    <h1 class="text-3xl font-bold text-indigo-950 mb-2">Ingresa tus datos</h1>
    <p class="text-slate-500 max-w-xl mx-auto">Por favor revisa e ingresa tus datos en el formulario. Revisa muy bien que los datos sean correctos. Ingresa todos los datos necesarios.</p>
  </div>

  <!-- Formulario -->
  <form action="/guardar" method="POST" class="mt-8 mb-14 bg-white p-8 rounded-3xl shadow-md max-w-xl w-full flex flex-col gap-4">
    <h2 class="text-xl font-bold text-indigo-950 mb-2">Tus datos</h2>
    <p class="text-slate-500 mb-4">Por favor revisa e ingresa tu información en los campos correspondientes</p>

    <div>
      <label class="block mb-1 font-medium text-indigo-950">No. de Trabajador </label>
      <input type="number" name="noTrabajador" value="<%= user.noTrabajador %>" class="border w-full p-3 rounded-full bg-gray-50" name="noTrabajador" disabled placeholder="Tu no. de trabajador" required>
    </div>


    <!-- Nombre -->
    <div>
      <label class="block mb-1 font-medium text-indigo-950">Nombre Completo</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" name="nombre" value="<%= user.nombre %>" disabled placeholder="Tu nombre" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-indigo-950">CURP</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" name="curp" value="<%= user.curp %>" disabled placeholder="Tu CURP" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-indigo-950">RFC</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" name="rfc" value="<%= user.rfc %>" disabled placeholder="Tu RFC" required>
    </div>

    <!-- Apellido Paterno -->
    <!--  
    <div>
      <label class="block mb-1 font-medium text-indigo-950">Apellido Paterno</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" placeholder="Apellido Paterno" required>
    </div>

     Apellido Materno
    <div>
      <label class="block mb-1 font-medium text-indigo-950">Apellido Materno</label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" placeholder="Apellido Materno" required>
    </div>

    -->

    <!-- Sexo -->
    <div>
      <label class="block mb-1 font-medium text-indigo-950">Seleccione su sexo</label>
      <select class="border w-full p-3 rounded-full bg-gray-50" name="sexo" id="sexo-opciones" required>
        <option value="sexo-masculino">Masculino</option>
        <option value="sexo-femenino">Femenino</option>
      </select>
    </div>

    <!-- ¿Estás embarazada? -->
    <div id="pregunta-embarazo" class="hidden">
      <label class="block mb-1 font-medium text-indigo-950">¿Estás embarazada?</label>
      <div class="flex gap-4">
        <label><input type="radio" name="embarazo" value="si" class="mr-2" id="radio-embarazo"> Sí</label>
        <label><input type="radio" name="embarazo" value="no" class="mr-2"> No</label>
      </div>
    </div>

    <!-- ¿Eres padre/madre? -->
    <div>
      <label class="block mb-1 font-medium text-indigo-950">¿Eres padre/madre?</label>
      <div class="flex gap-4">
        <label><input type="radio" name="papa" value="si" class="mr-2" id="padre" required> Sí</label>
        <label><input type="radio" name="papa" value="no" class="mr-2"> No</label>
      </div>
    </div>

    <!-- ¿Cuántos hijos tienes? -->
    <div id="preguntahijos" class="hidden">
      <label class="block mb-1 font-medium text-indigo-950">¿Cuántos hijos tienes?</label>
      <input class="border p-3 rounded-full bg-gray-50 w-32" type="number" id="hijoscontador" name="cantidadHijos" min="1" max="10">
    </div>

    <!-- Botón -->
    <button type="submit" class="mt-6 bg-gradient-to-b from-lime-500  to-verdegris text-white py-3 rounded-full text-xl font-bold hover:opacity-90">Siguiente</button>

  </form>

  <script src="/js/formulario.js"></script>
</body>

</html>

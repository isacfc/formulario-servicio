<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/styles.css" rel="stylesheet">

  <!-- Flatpickr -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/monthSelect/style.css">

  <title>Formulario - Poder Judicial</title>
</head>

<body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">

  <!-- Encabezado -->
  <header class="w-full bg-verdegris shadow-md flex justify-center items-center py-4">
    <img src="/images/pj-logo.png" alt="Logo" class="mr-12 w-20 h-auto">
    <label class="text-xl md:text-2xl font-bold text-white">PODER JUDICIAL DEL ESTADO DE HIDALGO</label>
  </header>

  <!-- Frase institucional -->
  <p class="italic text-green-800 font-medium text-xl mx-auto mt-4">“POR LA JUSTICIA QUE MERECEMOS.”</p>

  <!-- Títulos -->
  <div class="mt-12 text-center px-4">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Ingresa tus datos</h1>
    <p class="text-gray-600 max-w-xl mx-auto">Por favor, revisa e ingresa tus datos en el formulario. Asegúrate de que
      sean correctos.</p>
  </div>

  <!-- Formulario -->
  <form action="/guardar" method="POST"
    class="mt-8 mb-14 bg-white p-8 rounded-xl shadow border-2 border-verdegris max-w-xl w-full flex flex-col gap-5">
    <h2 class="text-2xl font-semibold text-gray-800 mb-2">Tus datos</h2>
    <p class="text-gray-600 mb-4">Por favor, revisa e ingresa tu información en los campos correspondientes. <br> Si
      alguno de los primeros 4 datos no es correcto, por favor acuda a Recursos Humanos del Poder Judicial del Estado de
      Hidalgo</p>

    <div>
      <label class="block mb-1 font-medium text-gray-700">No. de Trabajador</label>
      <input type="number" value="<%= user.noTrabajador %>"
        class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="noTrabajador" disabled
        placeholder="Tu no. de trabajador" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-gray-700">Nombre Completo</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="nombre"
        value="<%= user.nombreTrabajador %>" disabled placeholder="Tu nombre" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-gray-700">CURP</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="curp"
        value="<%= user.curp %>" disabled placeholder="Tu CURP" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-gray-700">RFC</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="rfc"
        value="<%= user.rfc %>" disabled placeholder="Tu RFC" required>
    </div>
    <div class="my-6 border-t border-gray-300 pt-4">
      <p class="text-center italic  text-verdegris font-bold">Rellene según los datos que se solicitan</p>
    </div>

    <div class="mb-3">
      <label class="block mb-1 text-gray-700 font-bold ">Fecha de Ingreso</label>
      <input type="text" class=" border border-gray-300 w-full p-3 rounded-md bg-gray-50" id="fechaIngreso"
        name="fechaIngreso" data-format="dd-mm-yyyy" placeholder="dd-mm-yyyy" required>

    </div>

    <div class="mb-3">
      <label class="block mb-1 text-gray-700 font-bold ">Adscripción actual</label>
      <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50" id=adscripcionActual
        name="adscripcionActual" placeholder="" required>

    </div>

    <div class="mb-3">
      <label class="block mb-1 text-gray-700 font-bold ">Cargo actual</label>
      <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50" id=cargoActual
        name="cargoActual" placeholder="" required>

    </div>


    <!-- Sexo -->
    <div>
      <label class="block mb-1 font-bold text-gray-700">Seleccione su sexo</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="sexo" id="sexo-opciones" required>
        <option value="Seleccione">Seleccione su sexo</option>
        <option value="Masculino">Masculino</option>
        <option value="Femenino">Femenino</option>
      </select>
    </div>

    <div class="mb-3">
      <label class="block mb-1 text-gray-700 font-bold ">Fecha de nacimiento</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" id=fechaNacimiento
        name="fechaNacimiento" data-format="dd-mm-yyyy" placeholder="dd-mm-yyyy" required>
    </div>


    <div class="mb-3">
      <label class="block mb-1 text-gray-700 font-bold ">Lugar de nacimiento <span class="text-red-500"> (MUNICIPIO Y
          ESTADO)</span></label>
      <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50" id=lugarNacimiento
        name="lugarNacimiento" placeholder="EJ. PACHUCA HIDALGO" required>

    </div>


    <div>
      <label class="block mb-1 font-bold text-gray-700">Estado Civil</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="civil" id="civil-opciones" required>
        <option value="Seleccione">Seleccione su estado</option>
        <option value="Soltero/a">Soltero/a</option>
        <option value="Casado/a">Casado/a</option>
      </select>
    </div>

    <div class="border border-gray-150 rounded-sm hidden" id="datosConyuge">
      <label class="block mb-1 text-gray-700 font-bold ">Datos de cónyuge</label>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Nombre de cónyuge <span class="text-red-500 font-bold">empezando por
            apellidos </span></label>
        <input type="text" class="conyuge acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          name="nombreConyuge" placeholder="AP PATERNO MATERNO NOMBRE(S)">
      </div>
      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Fecha de nacimiento de cónyuge</label>
        <input type="text" class="conyuge border border-gray-300 w-full p-3 rounded-md bg-gray-50" id=fechaConyuge
          name="fechaConyuge" placeholder="dd-mm-yyyy">

      </div>

      <div>
        <label class="block mb-1 text-gray-700">Sexo de cónyuge</label>
        <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="sexoConyuge"
          id="sexoConyuge-opciones" required>
          <option value="Seleccione">Seleccione el sexo</option>
          <option value="Masculino">Masculino</option>
          <option value="Femenino">Femenino</option>
        </select>
      </div>


    </div>


    <div>
      <label class="block mb-1 font-bold text-gray-700">Tipo de sangre</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="sangre" id="sangre-opciones"
        required>
        <option value="Seleccione">Seleccione su tipo</option>
        <option value="O+">O+</option>
        <option value="O-">O-</option>
        <option value="A+">A+</option>
        <option value="A-">A-</option>
        <option value="B+">B+</option>
        <option value="B-">B-</option>
        <option value="AB+">AB+</option>
        <option value="AB-">AB-</option>
      </select>
    </div>





    <div class="border border-gray-150 rounded-sm">
      <label class="block mb-1 text-gray-700 font-bold">Domicilio conforme a credencial para votar</label>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Calle y numero</label>
        <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          name="callenumero" placeholder="Calle y Número" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Colonia</label>
        <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          name="colonia" placeholder="Colonia" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Municipio</label>
        <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          name="municipio" placeholder="municipio" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Estado</label>
        <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          name="estado" placeholder="estado" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Codigo Postal</label>
        <input type="number" id="postal" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
          name="codigopostal" placeholder="Codigo Postal" required>
        <span id="error-message2" style="color: red; display: none;">El C.P. debe tener exactamente 5 dígitos.</span>

      </div>

    </div>

    <div>
      <label class="block mb-1 font-bold text-gray-700">Número de telefono celular (personal)</label>
      <input type="number" id="noTelefono" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
        name="telefono" placeholder="Tu No. de Telefono" required pattern="[0-9]{10}"
        title="El número debe tener exactamente 10 dígitos.">
      <span id="error-message" style="color: red; display: none;">El número debe tener exactamente 10 dígitos.</span>
    </div>


    <div>
      <label class="block mb-1 font-bold text-gray-700">Número de telefono de casa</label>
      <input type="number" id="noTelefono" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
        name="telefonocasa" placeholder="No. de Telefono de casa" required pattern="[0-9]{10}"
        title="El número debe tener exactamente 10 dígitos.">
      <span id="error-message" style="color: red; display: none;">El número debe tener exactamente 10 dígitos.</span>
    </div>

    <div class="border p-4 pt-2 pb-5">
      <label class="block mb-1 font-bold text-gray-700">Número de telefono de un familiar</label>
      <input type="number" id="noTelefono" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50"
        name="telefonofamiliar" placeholder="No. de Telefono de un familiar" required pattern="[0-9]{10}"
        title="El número debe tener exactamente 10 dígitos.">
      <span id="error-message" style="color: red; display: none;">El número debe tener exactamente 10 dígitos.</span>
      <label class="block mb-1 font-bold text-gray-700">Parentesco</label>
      <input type="text" class="acentos border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase"
        name="parentesco" placeholder="parentesco" required>

    </div>



    <div>
      <label class="block mb-1 text-gray-700 font-bold">Correo Electronico</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="correo"
        placeholder="Correo Electronico" required>
    </div>

    <div>
      <label class="block mb-1 font-bold text-gray-700">¿Padeces alguna enfermedad crónica?</label>
      <div class="flex gap-4">
        <label><input type="radio" name="cronica" value="1" class="mr-2" id="radio-cronica" required> Sí</label>
        <label><input type="radio" name="cronica" value="0" class="mr-2"> No</label>
      </div>
    </div>

    <div id="preguntaCronica" class="hidden">
      <label class="block mb-1 font-bold text-gray-700">¿Qué enfermedad padeces?</label>
      <input class="acentos border border-gray-300 p-3 rounded-md bg-gray-50 w-full uppercase" type="text"
        id="cronica-texto" placeholder="Enfermedad cronica" name="cronicaTexto">
    </div>

    <!-- ¿Estás embarazada? -->
    <div id="pregunta-embarazo" class="hidden">
      <label class="block mb-1 font-bold text-gray-700">¿Estás embarazada?</label>
      <div class="flex gap-4">
        <label><input type="radio" id="radio-embarazo" name="embarazo" value="1" class="mr-2"> Sí</label>
        <label><input type="radio" name="embarazo" value="0" class="mr-2"> No</label>
      </div>
    </div>

    <!-- ¿Eres padre/madre? -->
    <div>
      <label class="block mb-1 font-bold text-gray-700">¿Eres padre/madre?</label>
      <div class="flex gap-4">
        <label><input type="radio" name="papa" value="1" class="mr-2" id="padre" required> Sí</label>
        <label><input type="radio" name="papa" value="0" class="mr-2"> No</label>
      </div>
    </div>

    <!-- ¿Cuántos hijos tienes? -->
    <div id="preguntahijos" class="hidden">
      <label class="block mb-1 font-bold text-gray-700">¿Cuántos hijos tienes?</label>
      <input class="border border-gray-300 p-3 rounded-md bg-gray-50 w-32" type="number" id="hijoscontador"
        name="cantidadHijos" min="1" max="10">
    </div>

    <div id="espacioHijos"></div>

    <!-- ESCOLARIDAD -->
    <div class="border border-gray-300 p-4 rounded-md mt-4">
      <label class="block text-xl font-bold text-gray-700 mb-4">Escolaridad</label>

      <!-- PRIMARIA -->
      <p class="font-semibold text-gray-800 mb-1">Primaria <span class="text-red-600 font-bold">Requerido</span></p>
      <p class="text-gray-800 mb-1">Nombre de la primaria</p>
      <input type="text" name="primaria" required placeholder="Nombre de la escuela"
        class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

      <!-- SECUNDARIA -->
      <p class="font-semibold text-gray-800 mb-1">Secundaria <span class="text-red-600 font-bold">Requerido</span></p>
      <p class="text-gray-800 mb-1">Nombre de la secundaria</p>
      <input type="text" name="secundaria_institucion" required placeholder="Nombre de la escuela"
        class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

      <!-- DIVISOR -->
      <div class="my-6 border-t border-gray-300 pt-4">
        <p class="text-center italic  text-verdegris font-bold">Rellene según su máximo grado de estudios</p>
      </div>

      <p class="font-semibold text-gray-800 mb-1">Carrera tecnica o comercial <span
          class="text-sm italic text-gray-500">(opcional)</span></p>
      <p class="text-gray-800 mb-1">Nombre de la escuela</p>
      <input type="text" name="tecnica_institucion" placeholder="Nombre de la escuela"
        class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">



      <p class="font-semibold text-gray-800 mt-6 mb-1">
        Bachillerato <span class="text-sm italic text-gray-500">(opcional)</span>
      </p>
      <label>Nombre del bachillerato</label>
      <input type="text" name="prepa_titulo" placeholder="BACHILLERATO GENERAL"
        class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

      <label>Fecha de obtención de grado</label>
      <input type="text" name="prepa_fecha" data-format="mm-yyyy" class="border p-2 rounded-md bg-gray-50 w-full mb-2"
        placeholder="MM-AAAA">

      <label>Institución que expidió el título</label>
      <input type="text" name="prepa_institucion" class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

      <label>Documento adquirido</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="prepa_documento"
        id="doc_prepa_opciones">
        <option value="">Seleccione según el caso</option>
        <option value="DIPLOMA">Diploma</option>
        <option value="CONSTANCIA">Constancia</option>
        <option value="CERTIFICADO">Certificado</option>
        <option value="CARTA DE PASANTE">Carta de pasante</option>
        <option value="TITULO Y CEDULA">Titulo y cedula</option>
      </select>

      <label>Estatus</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="prepa_estatus"
        id="estatus_licenciatura_opciones">
        <option value="">Seleccione según el caso</option>
        <option value="INCONCLUSO">Inconcluso</option>
        <option value="CURSANDO">Cursando</option>
        <option value="CONCLUIDO">Concluido</option>
        <option value="TITULADO">Titulado</option>
      </select>

      <!-- LICENCIATURA -->
      <p class="font-semibold text-gray-800 mt-6 mb-1">
        Licenciatura <span class="text-sm italic text-gray-500">(opcional)</span>
      </p>
      <label>Nombre de la licenciatura</label>
      <input type="text" name="licenciatura_titulo1" placeholder="LICENCIATURA EN CIENCIAS COMPUTACIONALES"
        class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

      <label>Fecha de obtención de grado</label>
      <input type="text" name="licenciatura_fecha1" data-format="mm-yyyy"
        class="border p-2 rounded-md bg-gray-50 w-full mb-2" placeholder="MM-AAAA">

      <label>Institución que expidió el título</label>
      <input type="text" name="licenciatura_institucion1" class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

      <label>Documento adquirido</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="licenciatura_documento1"
        id="doc_licenciatura_opciones">
        <option value="">Seleccione según el caso</option>
        <option value="DIPLOMA">Diploma</option>
        <option value="CONSTANCIA">Constancia</option>
        <option value="CERTIFICADO">Certificado</option>
        <option value="CARTA DE PASANTE">Carta de pasante</option>
        <option value="TITULO Y CEDULA">Titulo y cedula</option>
      </select>

      <label>Estatus</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="licenciatura_estatus1"
        id="estatus_licenciatura_opciones">
        <option value="">Seleccione según el caso</option>
        <option value="INCONCLUSO">Inconcluso</option>
        <option value="CURSANDO">Cursando</option>
        <option value="CONCLUIDO">Concluido</option>
        <option value="TITULADO">Titulado</option>
      </select>


      <label>Número de cédula profesional</label>
      <input type="number" name="licenciatura_cedula1" class="border p-2 rounded-md bg-gray-50 w-full mb-4">

      <div class="hidden" id="lic2">
        <!-- LICENCIATURA2-->
        <p class="font-semibold text-gray-800 mt-6 mb-1">
          Licenciatura 2 <span class="text-sm italic text-gray-500">(opcional)</span>
        </p>
        <label>Nombre de la licenciatura 2</label>
        <input type="text" name="licenciatura_titulo2" placeholder="LICENCIATURA EN CIENCIAS COMPUTACIONALES"
          class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

        <label>Fecha de obtención de grado</label>
        <input type="text" name="licenciatura_fecha2" data-format="mm-yyyy"
          class="border p-2 rounded-md bg-gray-50 w-full mb-2" placeholder="MM-AAAA">

        <label>Institución que expidió el título</label>
        <input type="text" name="licenciatura_institucion2"
          class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

        <label>Documento adquirido</label>
        <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="licenciatura_documento2"
          id="doc_licenciatura_opciones">
          <option value="">Seleccione según el caso</option>
          <option value="DIPLOMA">Diploma</option>
          <option value="CONSTANCIA">Constancia</option>
          <option value="CERTIFICADO">Certificado</option>
          <option value="CARTA DE PASANTE">Carta de pasante</option>
          <option value="TITULO Y CEDULA">Titulo y cedula</option>
        </select>

        <label>Estatus</label>
        <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="licenciatura_estatus2"
          id="estatus_licenciatura_opciones">
          <option value="">Seleccione según el caso</option>
          <option value="INCONCLUSO">Inconcluso</option>
          <option value="CURSANDO">Cursando</option>
          <option value="CONCLUIDO">Concluido</option>
          <option value="TITULADO">Titulado</option>
        </select>


        <label>Número de cédula profesional</label>
        <input type="number" name="licenciatura_cedula2" class="border p-2 rounded-md bg-gray-50 w-full mb-4">
      </div>
      <div class="hidden" id="lic3">
        <!-- LICENCIATURA3-->
        <p class="font-semibold text-gray-800 mt-6 mb-1">
          Licenciatura 3 <span class="text-sm italic text-gray-500">(opcional)</span>
        </p>
        <label>Nombre de la licenciatura 3</label>
        <input type="text" name="licenciatura_titulo3" placeholder="LICENCIATURA EN CIENCIAS COMPUTACIONALES"
          class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

        <label>Fecha de obtención de grado</label>
        <input type="text" name="licenciatura_fecha3" data-format="mm-yyyy"
          class="border p-2 rounded-md bg-gray-50 w-full mb-2" placeholder="MM-AAAA">

        <label>Institución que expidió el título</label>
        <input type="text" name="licenciatura_institucion3"
          class="acentos border p-2 rounded-md bg-gray-50 w-full mb-2">

        <label>Documento adquirido</label>
        <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="licenciatura_documento3"
          id="doc_licenciatura_opciones">
          <option value="">Seleccione según el caso</option>
          <option value="DIPLOMA">Diploma</option>
          <option value="CONSTANCIA">Constancia</option>
          <option value="CERTIFICADO">Certificado</option>
          <option value="CARTA DE PASANTE">Carta de pasante</option>
          <option value="TITULO Y CEDULA">Titulo y cedula</option>
        </select>

        <label>Estatus</label>
        <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="licenciatura_estatus3"
          id="estatus_licenciatura_opciones">
          <option value="">Seleccione según el caso</option>
          <option value="INCONCLUSO">Inconcluso</option>
          <option value="CURSANDO">Cursando</option>
          <option value="CONCLUIDO">Concluido</option>
          <option value="TITULADO">Titulado</option>
        </select>


        <label>Número de cédula profesional</label>
        <input type="number" name="licenciatura_cedula3" class="border p-2 rounded-md bg-gray-50 w-full mb-4">
      </div>

      <button type="button" id="mostrarMasLicenciaturas"
        class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 text-sm mt-2">
        + Agregar otra licenciatura (3 max)

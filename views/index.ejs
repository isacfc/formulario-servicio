<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/styles.css" rel="stylesheet">

  <!-- Flatpickr -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  
  <title>Formulario - Poder Judicial</title>
</head>

<body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">

  <!-- Encabezado -->
  <header class="w-full bg-verdegris shadow-md flex justify-center items-center py-4">
    <img src="/images/pj-logo.png" alt="Logo" class="mr-12 w-20 h-auto">
    <label class="text-xl md:text-2xl font-bold text-white">PODER JUDICIAL DEL ESTADO DE HIDALGO</label>
  </header>

  <!-- Frase institucional -->
  <p class="italic text-green-800 font-medium text-xl mx-auto mt-4">“POR LA JUSTICIA QUE MERECEMOS.”</p>

  <!-- Títulos -->
  <div class="mt-12 text-center px-4">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Ingresa tus datos</h1>
    <p class="text-gray-600 max-w-xl mx-auto">Por favor, revisa e ingresa tus datos en el formulario. Asegúrate de que sean correctos.</p>
  </div>

  <!-- Formulario -->
  <form action="/guardar" method="POST" class="mt-8 mb-14 bg-white p-8 rounded-xl shadow border-2 border-verdegris max-w-xl w-full flex flex-col gap-5">
    <h2 class="text-2xl font-semibold text-gray-800 mb-2">Tus datos</h2>
    <p class="text-gray-600 mb-4">Por favor, revisa e ingresa tu información en los campos correspondientes. <br> Si alguno de los primero 4 datos no es correcto, por favor acuda a Recursos Humanos del Poder Judicial del Estado de Hidalgo</p>

    <div>
      <label class="block mb-1 font-medium text-gray-700">No. de Trabajador</label>
      <input type="number" value="<%= user.noTrabajador %>" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="noTrabajador" disabled placeholder="Tu no. de trabajador" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-gray-700">Nombre Completo</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="nombre" value="<%= user.nombreTrabajador %>" disabled placeholder="Tu nombre" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-gray-700">CURP</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="curp" value="<%= user.curp %>" disabled placeholder="Tu CURP" required>
    </div>

    <div>
      <label class="block mb-1 font-medium text-gray-700">RFC</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="rfc" value="<%= user.rfc %>" disabled placeholder="Tu RFC" required>
    </div>

    <!-- Sexo -->
    <div>
      <label class="block mb-1 font-bold text-gray-700">Seleccione su sexo</label>
      <select class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="sexo" id="sexo-opciones" required>
        <option value="Seleccione">Seleccione su sexo</option>
        <option value="Masculino">Masculino</option>
        <option value="Femenino">Femenino</option>
      </select>
    </div>

    <div>
      <label class="block mb-1 font-bold text-gray-700">Número de telefono celular (personal)</label>
      <input type="number" id="noTelefono" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="telefono"  placeholder="Tu No. de Telefono" required pattern="[0-9]{10}" title="El número debe tener exactamente 10 dígitos." >
      <span id="error-message" style="color: red; display: none;">El número debe tener exactamente 10 dígitos.</span>
    </div>


    <div  class="border border-gray-150 rounded-sm">
      <label class="block mb-1 text-gray-700 font-bold">Domicilio conforme a credencial para votar</label>
    
      <div class="mb-3">
      <label class="block mb-1 text-gray-700 ">Calle y numero</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase" name="callenumero" placeholder="Calle y Número" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Colonia</label>
        <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase" name="colonia" placeholder="Colonia" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Municipio</label>
        <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase" name="municipio" placeholder="municipio" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Estado</label>
        <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase" name="estado" placeholder="estado" required>
      </div>

      <div class="mb-3">
        <label class="block mb-1 text-gray-700 ">Codigo Postal</label>
        <input type="number" id="postal" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50 uppercase" name="codigopostal" placeholder="Codigo Postal" required>
        <span id="error-message2" style="color: red; display: none;">El C.P. debe tener exactamente 5 dígitos.</span>
    
      </div>
    
    </div>

    <div>
      <label class="block mb-1 text-gray-700 font-bold">Correo Electronico</label>
      <input type="text" class="border border-gray-300 w-full p-3 rounded-md bg-gray-50" name="correo" placeholder="Correo Electronico" required>
    </div>



    <!-- ¿Estás embarazada? -->
    <div id="pregunta-embarazo" class="hidden">
      <label class="block mb-1 font-bold text-gray-700">¿Estás embarazada?</label>
      <div class="flex gap-4">
        <label><input type="radio" id="radio-embarazo" name="embarazo" value="1" class="mr-2"> Sí</label>
        <label><input type="radio" name="embarazo" value="0" class="mr-2"> No</label>
      </div>
    </div>

    <!-- ¿Eres padre/madre? -->
    <div>
      <label class="block mb-1 font-bold text-gray-700">¿Eres padre/madre?</label>
      <div class="flex gap-4">
        <label><input type="radio" name="papa" value="1" class="mr-2" id="padre" required> Sí</label>
        <label><input type="radio" name="papa" value="0" class="mr-2"> No</label>
      </div>
    </div>

    <!-- ¿Cuántos hijos tienes? -->
    <div id="preguntahijos" class="hidden">
      <label class="block mb-1 font-bold text-gray-700">¿Cuántos hijos tienes?</label>
      <input class="border border-gray-300 p-3 rounded-md bg-gray-50 w-32" type="number" id="hijoscontador" name="cantidadHijos" min="1" max="10">
    </div>

    <div id="espacioHijos"></div>

    <!-- Botón -->
    <button type="submit" id="botonFormulario" class="mt-6 bg-verdegris hover:opacity-90 text-white py-3 rounded-md text-lg font-semibold transition">Siguiente</button>

  </form>

  <!-- Footer -->
  <footer class="w-full bg-verdegris text-white text-center py-4 mt-auto">
    <p class="text-sm">© 2025 Poder Judicial del Estado de Hidalgo. Todos los derechos reservados.</p>
  </footer>

  <!-- Inputmask -->
  <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>

  <!-- Flatpickr -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <!-- JS -->
  <script src="/js/formulario.js"></script>

</body>

</html>

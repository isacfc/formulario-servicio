<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/styles.css" rel="stylesheet">
  <title>Formulario - Poder Judicial</title>
</head>

<body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">

  <!-- Encabezado -->
  <header class="w-full bg-verdegris shadow-md p-3 flex justify-center items-center">
    <img src="/images/pj-logo.png" alt="Logo" class="mr-24 w-24 h-auto">
    <label class="text-2xl md:text-3xl font-bold text-white">Poder Judicial del Estado de Hidalgo</label>
  </header>

  <!-- Títulos -->
  <div class="mt-16 text-center">
    <h1 class="text-3xl font-bold text-indigo-950 mb-2">Ingresa con tu RFC</h1>
    <p class="text-slate-500 max-w-xl mx-auto">Tu clave de ingreso es tu RFC. Asegurate de introducirlo correctamente, ya que de otra forma el sistema no te dara acceso</p>
  </div>

  <!-- Formulario -->
  <form action="/login" method="POST" class="mt-8 mb-14 bg-white p-8 rounded-3xl shadow-md max-w-xl w-full flex flex-col gap-4">
    <h2 class="text-xl font-bold text-indigo-950 mb-2">Ingresa</h2>
    <p class="text-slate-500 mb-4">Por favor revisa e ingresa tu RFC para continuar</p>

    <div>
      <label class="block mb-1 font-medium text-indigo-950">RFC </label>
      <input type="text" class="border w-full p-3 rounded-full bg-gray-50" name="rfc" placeholder="Tu RFC" required>
    </div>


    <!-- Botón -->
    <button type="submit" class="mt-6 bg-gradient-to-b from-lime-500  to-verdegris text-white py-3 rounded-full text-xl font-bold hover:opacity-90">Siguiente</button>

  </form>

</body>

</html>

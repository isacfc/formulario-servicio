<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/styles.css" rel="stylesheet">
  <title>Formulario Enviado</title>
</head>
<body class="text-lg bg-gray-100 flex flex-col items-center min-h-screen">

  <!-- Encabezado -->
  <header class="w-full bg-verdegris shadow-md p-4 flex justify-center items-center">
    <img src="/images/pj-logo.png" alt="Logo" class="mr-12 w-20 h-auto">
    <label class="text-2xl md:text-3xl font-bold text-white">
      Poder Judicial del Estado de Hidalgo
    </label>
  </header>

  <!-- Frase institucional -->
  <p class="italic text-green-800 font-medium text-xl mx-auto mt-4">“POR LA JUSTICIA QUE MERECEMOS.”</p>

  <!-- Contenido principal -->
  <div class="mt-16 text-center px-4">
    <h1 class="text-3xl font-bold text-gray-800 mb-4">
      ¡Formulario Enviado Exitosamente!
    </h1>
    <p class="text-gray-600 max-w-xl mx-auto mb-8">
      Tu formulario ha sido enviado correctamente. <br> Gracias por tu participación, ya puedes cerrar esta ventana.
    </p>

    <!-- Palomita verdegris gigante -->
    <div class="mx-auto">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-48 w-48 mx-auto" style="color: #809484;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
  </div>

  <!-- Footer -->
  <footer class="w-full bg-verdegris text-white text-center py-4 mt-12">
    <p class="text-sm">© 2025 Poder Judicial del Estado de Hidalgo. Todos los derechos reservados.</p>
  </footer>
  <script>
    window.history.pushState(null, "", window.location.href);
    window.onpopstate = function() {
      // Destruye la sesión al darle "atrás"
      fetch('/logout') // Ruta logout
        .then(() => {
          window.location.href = '/login';
        });
    };
  </script>
</body>
</html>
